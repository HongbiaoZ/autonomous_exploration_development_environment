<sdf version='1.6'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose frame=''>0 0 300 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>0</shadows>
    </scene>
    <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>
    <!-- Local origin of the tile. Elevation is the DEM's vertical datum, not the WGS84 ellipsoid. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>38.42152269</latitude_deg>
      <longitude_deg>-110.78948351</longitude_deg>
      <elevation>1377.224</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <gravity>0 0 0</gravity>
    <magnetic_field>0 0 0</magnetic_field>
    <atmosphere type='adiabatic'/>
    <model name='map'>
      <static>1</static>
      <link name="link">
          <collision name="collision">
            <geometry>
              <mesh>
                <uri>model://hanksville/meshes/terrain.obj</uri>
              </mesh>
            </geometry>
          </collision>
          <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry>
              <mesh>
                <uri>model://hanksville/meshes/terrain.obj</uri>
              </mesh>
            </geometry>
            <material>
              <ambient>0.62 0.45 0.33 1</ambient>
              <diffuse>0.76 0.58 0.44 1</diffuse>
              <specular>0.05 0.05 0.05 1</specular>
            </material>
          </visual>
        </link>
      <pose frame=''>0 0 0 0 0 0</pose>
    </model>
  </world>
</sdf>
